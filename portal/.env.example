# Admin portal build-time config. Vite inlines every VITE_* value into the public JS bundle,
# so only put values here that are safe for anyone to see (no secrets).
# Copy to .env (local) or .env.production (`npm run build`) and fill in.

# Backend base URL, without /api/v1. Also add this portal's URL to the backend's CORS_ORIGINS.
VITE_API_BASE_URL=http://localhost:3000

# Google Maps JavaScript API key — restrict it to this portal's domain (HTTP referrer) in
# Google Cloud Console. Maps, zone drawing and the fare simulator need it.
VITE_GOOGLE_MAPS_KEY=

# Publishable payment keys (public by design). The backend normally returns the right key with
# each order; these are only a fallback. Use live keys only in the production build.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_RAZORPAY_KEY_ID=
