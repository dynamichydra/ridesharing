# NOTE: Storage (S3), OTP (Twilio), email (SMTP) and payments (Razorpay/Stripe) auto-detect
# their config below. Outside production, an unset block falls back to a local dev mode
# (files saved to ./uploads, OTP/email codes logged to the console). In production nothing
# falls back silently: the server refuses to start without Twilio, webhook secrets, CORS
# origins etc., and payments fail with 503 instead of crediting without a charge.
# Production secrets belong in your host's secret manager, never in a committed file.

# Server
PORT=3000
NODE_ENV=development
API_VERSION=v1
# Base URL used to build local dev-storage links when S3 isn't configured (optional,
# defaults to http://localhost:$PORT)
APP_BASE_URL=http://localhost:3000
# Pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
# Browser origins allowed by CORS and Socket.IO (comma-separated) — the admin portal URL(s).
# Required in production. Mobile apps send no Origin and are unaffected.
CORS_ORIGINS=http://localhost:5173
# Bearer token required for GET /metrics in production (unset = /metrics disabled there)
METRICS_TOKEN=
# Serve Swagger UI at /docs in production (always on outside production)
ENABLE_API_DOCS=false
# Minimum seconds a driver must wait at pickup before declaring a rider no-show
NO_SHOW_MIN_WAIT_SEC=300

# ── Development-only switches (the server refuses to start with these in production) ──
# Socket test UIs, /socket-test/quick-auth token minting, public / and /test socket namespaces
ENABLE_DEV_TOOLS=false
# Credit rides / wallet top-ups / rider plans without a real charge when a gateway has no keys
PAYMENTS_DEV_BYPASS=false
# Fixed OTP for emulator testing when Twilio isn't configured (e.g. 123456). Leave empty for random codes.
OTP_DEV_CODE=
# Local-disk stand-in for S3 when S3 isn't configured. Defaults to on outside production;
# set true in production only for a deliberate single-server deployment without S3.
# ALLOW_LOCAL_STORAGE=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rideshare
DB_USER=postgres
DB_PASSWORD=password
# Set to true for managed/cloud Postgres (Aiven, RDS, etc.) — most require SSL and will
# refuse a plaintext connection. Leave false for local/docker Postgres.
DB_SSL=false
# PEM contents of the provider's CA bundle (
-escaped is fine) — verifies the DB server cert
DB_SSL_CA=
# Connections per instance (DB_POOL_MAX x instance count must stay under the DB's limit)
DB_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rideshare-api
KAFKA_GROUP_ID=rideshare-group

# JWT
# Two DIFFERENT random secrets, 32+ chars each — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production if they're missing, short, or identical.
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m   # keep access tokens short — clients refresh via /auth/refresh
JWT_REFRESH_EXPIRES_IN=30d

# Twilio (OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Google Maps
GOOGLE_MAPS_KEY=your_google_maps_api_key
# Rider app India/Canada region lock (GPS + IP + phone country). Set to off only for local
# simulator testing outside IN/CA.
RIDER_REGION_ENFORCEMENT=off

# Razorpay — INR (India) gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Stripe — CAD (Canada) gateway. Currency->gateway mapping lives in
# src/modules/payment/payment.service.js.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Stripe Connect — driver payouts (src/modules/payout-account, src/modules/payout). Connect
# events (account.updated etc.) are configured as a separate webhook endpoint in Stripe's
# dashboard from the payment webhook above, so they get their own secret.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxx
# Where Stripe's hosted onboarding flow redirects a driver back to when they finish/need to
# retry — leave unset until a driver mobile app exists; the backend's own placeholder
# acknowledgement routes are used as a fallback for manual testing until then.
# DRIVER_APP_ONBOARDING_RETURN_URL=rideshare-driver://onboarding-return
# DRIVER_APP_ONBOARDING_REFRESH_URL=rideshare-driver://onboarding-refresh

# Firebase (FCM)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# AWS S3 / Cloudflare R2
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=rideshare-uploads
S3_PUBLIC_URL=https://cdn.yourdomain.com

# AES-256 key for encrypting stored bank/payout details — required in production.
# Must be 32 bytes, base64-encoded. Generate: openssl rand -base64 32
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BANK_DETAILS_ENC_KEY=
# RazorpayX account used for driver payouts (optional in development)
RAZORPAYX_ACCOUNT_NUMBER=

# Email (SMTP) — driver email sign-in codes and notification emails. Works with SES SMTP,
# Mailgun, Postmark, SendGrid SMTP, etc. Required for email sign-in in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="RideShare <no-reply@yourdomain.com>"
