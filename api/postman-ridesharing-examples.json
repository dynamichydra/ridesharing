        {
          "name": "Fare Estimate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupLat\": 22.5726,\n  \"pickupLng\": 88.3639,\n  \"destinationLat\": 22.5797,\n  \"destinationLng\": 88.4337\n}"
            },
            "url": "{{baseUrl}}/api/v1/trips/fare-estimate"
          }
        },
        {
          "name": "Request Ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('tripId', body.trip.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupAddress\": \"Esplanade, Kolkata\",\n  \"pickupLat\": 22.5726,\n  \"pickupLng\": 88.3639,\n  \"destinationAddress\": \"Salt Lake Sector V, Kolkata\",\n  \"destinationLat\": 22.5797,\n  \"destinationLng\": 88.4337,\n  \"vehicleType\": \"car\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/trips/request"
          }
        },
        {
          "name": "Rider My Trips",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/trips/my-trips"
          }
        },
        {
          "name": "Matching Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/matching/status/{{tripId}}"
          }
        },
        {
          "name": "Cancel Ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Testing rider cancellation\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/cancel"
          }
        }
      ]
