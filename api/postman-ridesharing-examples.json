        },
        {
          "name": "Accept Trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/accept"
          }
        },
        {
          "name": "Driver Arrived",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/arrived"
          }
        },
        {
          "name": "Start Trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/start"
          }
        },
        {
          "name": "Complete Trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/complete"
          }
        }
      ]
