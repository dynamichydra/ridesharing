# NOTE: Storage (S3), OTP (Twilio), and payments (Razorpay) all auto-detect their own
# config below. Leave a block's keys unset and that service falls back to a local/dummy
# dev mode (files saved to backend/uploads/, OTP codes logged to the console, dev
# subscription activation is skipped for payment) — fill the keys in and it switches to
# the real integration automatically, no other flag to flip.

# Server
PORT=3000
NODE_ENV=development
API_VERSION=v1
# Base URL used to build local dev-storage links when S3 isn't configured (optional,
# defaults to http://localhost:$PORT)
APP_BASE_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rideshare
DB_USER=postgres
DB_PASSWORD=password
# Set to true for managed/cloud Postgres (Aiven, RDS, etc.) — most require SSL and will
# refuse a plaintext connection. Leave false for local/docker Postgres.
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rideshare-api
KAFKA_GROUP_ID=rideshare-group

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Twilio (OTP)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Google Maps
GOOGLE_MAPS_KEY=your_google_maps_api_key

# Razorpay — INR (India) gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Stripe — CAD (Canada) gateway. Currency->gateway mapping lives in
# src/modules/payment/payment.service.js.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Stripe Connect — driver payouts (src/modules/payout-account, src/modules/payout). Connect
# events (account.updated etc.) are configured as a separate webhook endpoint in Stripe's
# dashboard from the payment webhook above, so they get their own secret.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxx

# Firebase (FCM)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# AWS S3 / Cloudflare R2
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=rideshare-uploads
S3_PUBLIC_URL=https://cdn.yourdomain.com
